#!/bin/sh
# Start Usage Monitor for Claude without activating the virtual environment
# first, and from any working directory.
#
# Symlink it somewhere on your PATH to get a global command:
#     ln -s "$PWD/usage-monitor-for-claude" ~/.local/bin/usage-monitor-for-claude
#
# The symlink is resolved before the directory is taken, so the script finds its
# own checkout rather than wherever it was called from.  PYTHONPATH, not a "cd",
# is what puts the package within reach: "python -m" searches the working
# directory, and changing that would be a side effect the application does not
# ask for.
set -eu

here=$(dirname -- "$(readlink -f -- "$0")")

if [ ! -x "$here/.venv/bin/python" ]; then
    echo "No virtual environment in $here/.venv - see the Linux section of README.md." >&2
    exit 1
fi

PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$here/.venv/bin/python" -m usage_monitor_for_claude "$@"
